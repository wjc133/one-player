{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "One Player",
  "version": "0.1.0",
  "identifier": "cn.oneplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "One Player",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "acceptFirstMouse": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#0a0d11"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "shortDescription": "A focused music player with LX custom source support",
    "longDescription": "Search, organize, download and play music through LX-compatible custom source scripts."
  }
}

