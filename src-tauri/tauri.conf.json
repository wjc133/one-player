{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "One Player",
  "version": "0.2.0",
  "identifier": "cn.oneplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "One Player",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "acceptFirstMouse": true,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#0a0d11"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "shortDescription": "A focused music player with LX custom source support",
    "longDescription": "Search, organize, download and play music through LX-compatible custom source scripts."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMjA4M0Y4MTNFREM4OEYKUldTUHlPMFQrSU1nd2I5c0F3WjBXbEFjTEh3WmR2VzcvZTJCa2E2YjVJRFlKS2U2R0J5dTJXczMK",
      "endpoints": [
        "https://github.com/wjc133/one-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

