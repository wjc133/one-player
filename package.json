{
  "name": "one-player",
  "private": true,
  "version": "0.5.0",
  "description": "A desktop music player with LX-compatible custom sources, local libraries, and WALKMAN management",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wjc133/one-player.git"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:release": "pnpm tauri build",
    "test": "node --test tests/*.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "buffer": "^6.0.3",
    "lucide-react": "^0.468.0",
    "node-forge": "^1.3.1",
    "pako": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
